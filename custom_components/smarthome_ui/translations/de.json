{
  "config": {
    "step": {
      "user": {
        "title": "Smarthome UI Core",
        "description": "Mitteilungen und Haushaltsdaten für das Smarthome-UI-Dashboard. Eingestellt wird alles im Dashboard."
      }
    },
    "abort": {
      "single_instance_allowed": "Smarthome UI Core ist schon eingerichtet."
    }
  },
  "config_subentries": {
    "mower": {
      "entry_type": "Mähroboter",
      "initiate_flow": {
        "user": "Mähroboter hinzufügen",
        "reconfigure": "Mähroboter ändern"
      },
      "step": {
        "user": {
          "title": "Mähroboter hinzufügen",
          "description": "Gerät des Mähroboters wählen. Smarthome UI Core findet Status, Flächen, Selbsttest und Messer selbst und merkt sich, wann welche Fläche gemäht wurde – auch ohne offenes Dashboard.",
          "data": {
            "device_id": "Mähroboter",
            "name": "Name (optional)"
          }
        },
        "reconfigure": {
          "title": "Mähroboter ändern",
          "data": {
            "device_id": "Mähroboter",
            "name": "Name (optional)",
            "auto_from": "Automatik ab",
            "auto_to": "Automatik bis",
            "cond_quiet": "Nicht in der Ruhezeit (Mitteilungen)",
            "cond_away": "Nur wenn niemand zuhause ist",
            "cond_rain": "Nicht bei Regen",
            "cond_solar": "Nur mit Solarstrom",
            "solar_entity": "Sensor PV-Leistung oder Überschuss",
            "solar_min": "Mindestens",
            "announce": "Vorher ankündigen (0 = sofort starten)"
          },
          "description": "Automatisch mähen/saugen: Wann der Roboter selbst starten darf, wenn Flächen bzw. Räume fällig sind (Schalter „Automatisch …“ am Gerät). Jede Bedingung lässt sich abschalten."
        }
      },
      "abort": {
        "already_configured": "Dieser Mähroboter ist schon hinzugefügt.",
        "reconfigure_successful": "Mähroboter geändert."
      }
    },
    "vacuum": {
      "entry_type": "Saugroboter",
      "initiate_flow": {
        "user": "Saugroboter hinzufügen",
        "reconfigure": "Saugroboter ändern"
      },
      "step": {
        "user": {
          "title": "Saugroboter hinzufügen",
          "description": "Gerät des Saugroboters wählen. Smarthome UI Core merkt sich, wann er welchen Raum gereinigt hat (mit Raum-Sensor, z. B. Roborock), und meldet Fehler, Station und Verschleißteile – auch ohne offenes Dashboard.",
          "data": {
            "device_id": "Saugroboter",
            "name": "Name (optional)"
          }
        },
        "reconfigure": {
          "title": "Saugroboter ändern",
          "data": {
            "device_id": "Saugroboter",
            "name": "Name (optional)",
            "auto_from": "Automatik ab",
            "auto_to": "Automatik bis",
            "cond_quiet": "Nicht in der Ruhezeit (Mitteilungen)",
            "cond_away": "Nur wenn niemand zuhause ist",
            "cond_solar": "Nur mit Solarstrom",
            "solar_entity": "Sensor PV-Leistung oder Überschuss",
            "solar_min": "Mindestens",
            "announce": "Vorher ankündigen (0 = sofort starten)",
            "mop_every": "Wischen alle … Tage (0 = Planer wischt nicht)"
          },
          "description": "Automatisch mähen/saugen: Wann der Roboter selbst starten darf, wenn Flächen bzw. Räume fällig sind (Schalter „Automatisch …“ am Gerät). Jede Bedingung lässt sich abschalten."
        }
      },
      "abort": {
        "already_configured": "Dieser Saugroboter ist schon hinzugefügt.",
        "reconfigure_successful": "Saugroboter geändert."
      }
    },
    "appliance": {
      "entry_type": "Haushaltsgerät",
      "initiate_flow": {
        "user": "Haushaltsgerät hinzufügen",
        "reconfigure": "Haushaltsgerät ändern"
      },
      "step": {
        "user": {
          "title": "Haushaltsgerät hinzufügen",
          "description": "Gerät eines Geschirrspülers, einer Waschmaschine, eines Trockners oder Kühlschranks wählen. Smarthome UI Core verfolgt die Läufe und meldet, wenn es fertig ist, eine Störung hat oder noch ausgeräumt werden muss (Kühlschrank: Tür offen, zu warm, Alarm) – auch ohne offenes Dashboard.",
          "data": {
            "device_id": "Gerät",
            "name": "Name (optional)",
            "kind": "Art"
          }
        },
        "reconfigure": {
          "title": "Haushaltsgerät ändern",
          "description": "Der Sonnenstrom-Hinweis kommt, während das Gerät per Startvorwahl wartet und genug Sonnenstrom da ist.",
          "data": {
            "device_id": "Gerät",
            "name": "Name (optional)",
            "kind": "Art",
            "reminder": "An Ausräumen erinnern nach (0 = nie)",
            "solar_entity": "Sensor PV-Leistung oder Überschuss",
            "solar_min": "Sonnenstrom-Hinweis ab",
            "door_minutes": "Tür-offen-Warnung nach",
            "max_temp": "Kühlteil zu warm ab",
            "freezer_max_temp": "Gefrierteil zu warm über"
          }
        }
      },
      "abort": {
        "already_configured": "Dieses Gerät ist schon hinzugefügt.",
        "reconfigure_successful": "Haushaltsgerät geändert."
      }
    }
  },
