{
  "config": {
    "step": {
      "user": {
        "title": "Smarthome UI Core",
        "description": "Notifications and household data for the Smarthome UI dashboard. Everything is set up in the dashboard."
      }
    },
    "abort": {
      "single_instance_allowed": "Smarthome UI Core is already set up."
    }
  },
  "config_subentries": {
    "mower": {
      "entry_type": "Robot mower",
      "initiate_flow": {
        "user": "Add robot mower",
        "reconfigure": "Change robot mower"
      },
      "step": {
        "user": {
          "title": "Add robot mower",
          "description": "Pick the mower's device. Smarthome UI Core finds state, areas, self check and blades itself and remembers when each area was mowed – even without an open dashboard.",
          "data": {
            "device_id": "Robot mower",
            "name": "Name (optional)"
          }
        },
        "reconfigure": {
          "title": "Change robot mower",
          "data": {
            "device_id": "Robot mower",
            "name": "Name (optional)"
          }
        }
      },
      "abort": {
        "already_configured": "This robot mower is already added.",
        "reconfigure_successful": "Robot mower changed."
      }
    },
    "vacuum": {
      "entry_type": "Robot vacuum",
      "initiate_flow": {
        "user": "Add robot vacuum",
        "reconfigure": "Change robot vacuum"
      },
      "step": {
        "user": {
          "title": "Add robot vacuum",
          "description": "Pick the vacuum's device. Smarthome UI Core remembers when it cleaned each room (with a room sensor, e.g. Roborock) and notifies about errors, the station and wear parts – even without an open dashboard.",
          "data": {
            "device_id": "Robot vacuum",
            "name": "Name (optional)"
          }
        },
        "reconfigure": {
          "title": "Change robot vacuum",
          "data": {
            "device_id": "Robot vacuum",
            "name": "Name (optional)"
          }
        }
      },
      "abort": {
        "already_configured": "This robot vacuum is already added.",
        "reconfigure_successful": "Robot vacuum changed."
      }
    }
  },
  "device": {
    "notifications": {
      "name": "Notifications"
    },
    "household": {
      "name": "Household"
    },
    "garden": {
      "name": "Garden"
    }
  },
  "entity": {
    "sensor": {
      "task": {
        "name": "Task"
      },
      "last_notification": {
        "name": "Last sent"
      },
      "display_user": {
        "name": "User"
      },
      "mow_area": {
        "name": "{area} last mowed"
      },
      "vacuum_room": {
        "name": "{area} last vacuumed"
      }
    },
    "binary_sensor": {
      "display_online": {
        "name": "Connected"
      }
    },
    "button": {
      "display_reload": {
        "name": "Reload"
      }
    },
    "select": {
      "display_page": {
        "name": "Page"
      },
      "display_theme": {
        "name": "Theme",
        "state": {
          "dark": "Dark",
          "sand": "Sand",
          "clay": "Clay",
          "auto": "Automatic"
        }
      },
      "display_season": {
        "name": "Season",
        "state": {
          "auto": "Automatic",
          "off": "Off",
          "halloween": "Halloween",
          "herbst": "Autumn",
          "nikolaus": "St. Nicholas",
          "weihnachten": "Christmas",
          "winter": "Winter",
          "valentin": "Valentine's Day",
          "fruehling": "Spring",
          "ostern": "Easter",
          "sommer": "Summer",
          "hobbit": "Hobbit Day",
          "geburtstag": "Birthday"
        }
      },
      "display_sounds": {
        "name": "Sounds",
        "state": {
          "off": "Off",
          "quiet": "Quiet",
          "normal": "Normal"
        }
      },
      "display_performance": {
        "name": "Performance",
        "state": {
          "auto": "Automatic",
          "full": "All effects",
          "lite": "Lite"
        }
      },
      "mow_frequency": {
        "name": "Mowing {area}",
        "state": {
          "often": "More often",
          "normal": "Normal",
          "rare": "Less often",
          "pause": "Pause"
        }
      }
    },
    "switch": {
      "display_standby": {
        "name": "Standby"
      }
    },
    "number": {
      "clean_interval": {
        "name": "Cleaning {area}"
      }
    }
  },
  "services": {
    "task_done": {
      "name": "Task done",
      "description": "Marks a task (name or key) as done.",
      "fields": {
        "task": {
          "name": "Task",
          "description": "Name as in the dashboard, e.g. \"Clean bathroom\", or a key like clean:bad."
        }
      }
    },
    "task_reopen": {
      "name": "Reopen task",
      "description": "Sets a done task back to open.",
      "fields": {
        "task": {
          "name": "Task",
          "description": "Name or key of the task."
        }
      }
    },
    "waste_ack": {
      "name": "Waste put out",
      "description": "Marks the waste collection on this day as put out.",
      "fields": {
        "date": {
          "name": "Date",
          "description": "Day of the collection."
        }
      }
    },
    "waste_skip": {
      "name": "Skip waste",
      "description": "Do not put out this time – no reminder.",
      "fields": {
        "date": {
          "name": "Date",
          "description": "Day of the collection."
        }
      }
    },
    "area_mowed": {
      "name": "Area mowed",
      "description": "Marks a mowing area as mowed now.",
      "fields": {
        "area": {
          "name": "Area",
          "description": "Name of the area as in the dashboard."
        }
      }
    },
    "test_notify": {
      "name": "Test notification",
      "description": "Sends a test notification to all targets.",
      "fields": {
        "message": {
          "name": "Message",
          "description": "Optional text."
        }
      }
    }
  },
  "exceptions": {
    "not_loaded": {
      "message": "Smarthome UI Core is not set up."
    },
    "unknown_task": {
      "message": "There is no task \"{task}\"."
    },
    "no_targets": {
      "message": "No notify target found (notify.mobile_app_… or targets chosen in the dashboard)."
    },
    "display_offline": {
      "message": "The display \"{display}\" is not connected right now (dashboard not open)."
    }
  }
}
