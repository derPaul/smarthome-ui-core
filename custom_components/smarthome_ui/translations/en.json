{
  "config": {
    "step": {
      "user": {
        "title": "Smarthome UI Core",
        "description": "Notifications and household data for the Smarthome UI dashboard. Everything is set up in the dashboard."
      }
    },
    "abort": {
      "single_instance_allowed": "Smarthome UI Core is already set up."
    }
  },
  "config_subentries": {
    "mower": {
      "entry_type": "Robot mower",
      "initiate_flow": {
        "user": "Add robot mower",
        "reconfigure": "Change robot mower"
      },
      "step": {
        "user": {
          "title": "Add robot mower",
          "description": "Pick the mower's device. Smarthome UI Core finds state, areas, self check and blades itself and remembers when each area was mowed – even without an open dashboard.",
          "data": {
            "device_id": "Robot mower",
            "name": "Name (optional)"
          }
        },
        "reconfigure": {
          "title": "Change robot mower",
          "data": {
            "device_id": "Robot mower",
            "name": "Name (optional)",
            "auto_from": "Automatic from",
            "auto_to": "Automatic until",
            "cond_quiet": "Not during quiet hours (notifications)",
            "cond_away": "Only when nobody is home",
            "cond_rain": "Not when it rains",
            "cond_solar": "Only with solar power",
            "solar_entity": "Sensor PV power or surplus",
            "solar_min": "At least",
            "announce": "Announce ahead (0 = start right away)"
          },
          "description": "Mow/vacuum automatically: when the robot may start on its own if areas or rooms are due (switch \"... automatically\" on the device). Every condition can be switched off."
        }
      },
      "abort": {
        "already_configured": "This robot mower is already added.",
        "reconfigure_successful": "Robot mower changed."
      }
    },
    "vacuum": {
      "entry_type": "Robot vacuum",
      "initiate_flow": {
        "user": "Add robot vacuum",
        "reconfigure": "Change robot vacuum"
      },
      "step": {
        "user": {
          "title": "Add robot vacuum",
          "description": "Pick the vacuum's device. Smarthome UI Core remembers when it cleaned each room (with a room sensor, e.g. Roborock) and notifies about errors, the station and wear parts – even without an open dashboard.",
          "data": {
            "device_id": "Robot vacuum",
            "name": "Name (optional)"
          }
        },
        "reconfigure": {
          "title": "Change robot vacuum",
          "data": {
            "device_id": "Robot vacuum",
            "name": "Name (optional)",
            "auto_from": "Automatic from",
            "auto_to": "Automatic until",
            "cond_quiet": "Not during quiet hours (notifications)",
            "cond_away": "Only when nobody is home",
            "cond_solar": "Only with solar power",
            "solar_entity": "Sensor PV power or surplus",
            "solar_min": "At least",
            "announce": "Announce ahead (0 = start right away)",
            "mop_every": "Mop every … days (0 = planner does not mop)"
          },
          "description": "Mow/vacuum automatically: when the robot may start on its own if areas or rooms are due (switch \"... automatically\" on the device). Every condition can be switched off."
        }
      },
      "abort": {
        "already_configured": "This robot vacuum is already added.",
        "reconfigure_successful": "Robot vacuum changed."
      }
    },
    "appliance": {
      "entry_type": "Household appliance",
      "initiate_flow": {
        "user": "Add household appliance",
        "reconfigure": "Change household appliance"
      },
      "step": {
        "user": {
          "title": "Add household appliance",
          "description": "Pick the device of a dishwasher, washing machine, dryer or fridge. Smarthome UI Core follows its runs and notifies when it is finished, has an error or still needs unloading (fridge: door open, too warm, alarm) – even without an open dashboard.",
          "data": {
            "device_id": "Appliance",
            "name": "Name (optional)",
            "kind": "Kind"
          }
        },
        "reconfigure": {
          "title": "Change household appliance",
          "description": "The solar hint comes while the appliance waits for its delayed start and there is enough solar power.",
          "data": {
            "device_id": "Appliance",
            "name": "Name (optional)",
            "kind": "Kind",
            "reminder": "Remind to unload after (0 = never)",
            "solar_entity": "Sensor PV power or surplus",
            "solar_min": "Solar hint from",
            "door_minutes": "Door open warning after",
            "max_temp": "Fridge too warm from",
            "freezer_max_temp": "Freezer too warm above"
          }
        }
      },
      "abort": {
        "already_configured": "This appliance is already added.",
        "reconfigure_successful": "Appliance changed."
      }
    },
    "part": {
      "entry_type": "Maintenance part",
      "initiate_flow": {
        "user": "Add maintenance part",
        "reconfigure": "Change maintenance part"
      },
      "step": {
        "user": {
          "title": "Add maintenance part",
          "description": "Carbon filter, air or water filter, backwash filter, smoke detector … Without a device, Smarthome UI Core creates one in the area. Due cleaning and replacing land in the to-do list \"Household\" and come as notification.",
          "data": {
            "kind": "Kind",
            "area_id": "Area",
            "device_id": "Belongs to device (optional)",
            "name": "Name (optional)"
          }
        },
        "intervals": {
          "title": "Intervals",
          "description": "Suggested for {kind} – change as you like. Replacing counts as cleaned too.",
          "data": {
            "clean_every": "Clean / backwash / test every (0 = off)",
            "replace_every": "Replace every (0 = off)"
          }
        },
        "reconfigure": {
          "title": "Change maintenance part",
          "data": {
            "kind": "Kind",
            "area_id": "Area",
            "device_id": "Belongs to device (optional)",
            "name": "Name (optional)",
            "clean_every": "Clean / backwash / test every (0 = off)",
            "replace_every": "Replace every (0 = off)"
          }
        }
      },
      "abort": {
        "reconfigure_successful": "Maintenance part changed."
      }
    }
  },
