          "description": "Name as in the dashboard, e.g. \"Clean bathroom\", or a key like clean:bad."
        }
      }
    },
    "task_reopen": {
      "name": "Reopen task",
      "description": "Sets a done task back to open.",
      "fields": {
        "task": {
          "name": "Task",
